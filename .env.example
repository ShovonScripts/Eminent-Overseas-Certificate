APP_NAME="Eminent Certificates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use "warning" or "error" in production.
LOG_LEVEL=debug

# SQLite works out of the box. For MySQL use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=eminent_certificates
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@eminentoverseas.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Used inside the QR code. Must be the PUBLIC domain in production.
CERTIFICATE_VERIFY_BASE_URL="${APP_URL}/verify"

SCHOOL_NAME="Eminent Overseas & Consultants"
SCHOOL_ADDRESS="16/9, Indira Road, Behind Tejgaon College, Dhaka 1215"
SCHOOL_PHONE="+88 01816877795"
SCHOOL_EMAIL="info@eminentoverseas.uk"

VITE_APP_NAME="${APP_NAME}"
